{
  "name": "@codebase-tutor/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts; code=$?; [ \"$code\" = 130 ] && exit 0 || exit $code",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.dev.json",
    "unused:check": "node dev/unused-check.cjs $(find src dev -name \"*.ts\" -not -name \"*.test.ts\")",
    "test": "vitest run",
    "test:watch": "vitest",
    "analysis:lock": "tsx dev/mutate/lock-analysis-steps.ts",
    "experiment": "tsx dev/experiment/bench.ts",
    "experiment:baseline": "tsx dev/experiment/bench.ts --dataset=experiments/baseline-2026-11",
    "eval:metrics": "tsx dev/probe/metrics.ts",
    "run-trace": "tsx dev/probe/run-trace.ts",
    "dataflow:report": "tsx dev/probe/dataflow-report.ts",
    "setup:native": "node scripts/setup-native-bindings.mjs",
    "eval:quality": "tsx dev/eval/eval-run.ts",
    "eval:judge": "tsx dev/eval/judge-turns.ts",
    "probe:cache": "tsx dev/probe/probe-prefix-cache.ts",
    "llm:profile": "tsx dev/probe/llm-profile.ts",
    "arch:externals": "tsx dev/probe/external-scan.ts",
    "facts:report": "tsx dev/probe/facts-report.ts",
    "probe:sandbox": "tsx dev/probe/probe-exercise-coverage.ts",
    "probe:code-exercise": "tsx dev/probe/probe-code-exercise.ts",
    "probe:graph": "tsx dev/probe/precise-graph-diff.ts",
    "probe:calls": "tsx dev/probe/precise-call-diff.ts",
    "probe:import-summary": "tsx dev/probe/import-summary-replay.ts",
    "reanalyze": "tsx dev/mutate/reanalyze.ts",
    "l1:reburn": "tsx dev/mutate/reburn-l1.ts"
  },
  "dependencies": {
    "@codebase-tutor/analysis": "workspace:*",
    "@codebase-tutor/contract": "workspace:*",
    "@codebase-tutor/domain": "workspace:*",
    "@codebase-tutor/platform": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.3.2",
    "typescript": "^5.8.3",
    "typescript-language-server": "^4.3.4",
    "web-tree-sitter": "^0.27.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.3",
    "vitest": "^3.1.3"
  }
}
