{
  "name": "@codebase-tutor/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts; code=$?; [ \"$code\" = 130 ] && exit 0 || exit $code",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "analysis:lock": "tsx src/scripts/lock-analysis-steps.ts",
    "phase0:prepare-study": "tsx src/scripts/prepare-study.ts",
    "phase0:audit": "tsx src/scripts/audit.ts",
    "phase0:metrics": "tsx src/scripts/metrics.ts",
    "run-trace": "tsx src/scripts/run-trace.ts",
    "dataflow:report": "tsx src/scripts/dataflow-report.ts",
    "phase0:replay-coverage": "tsx src/scripts/replay-coverage.ts",
    "setup:native": "node scripts/setup-native-bindings.mjs",
    "phaseB:eval": "tsx src/scripts/eval-run.ts",
    "phaseB:judge": "tsx src/scripts/judge-turns.ts",
    "search:embed": "tsx src/scripts/embed-repo.ts",
    "cache:probe": "tsx src/scripts/probe-prefix-cache.ts",
    "llm:profile": "tsx src/scripts/llm-profile.ts",
    "arch:keyprobe": "tsx src/scripts/arch-key-probe.ts",
    "arch:externals": "tsx src/scripts/external-scan.ts",
    "arch:blocks": "tsx src/scripts/arch-blocks.ts",
    "sandbox:coverage": "tsx src/scripts/probe-exercise-coverage.ts",
    "probe:code-exercise": "tsx src/scripts/probe-code-exercise.ts",
    "graph:diff": "tsx src/scripts/precise-graph-diff.ts",
    "calls:diff": "tsx src/scripts/precise-call-diff.ts",
    "tier:diag": "tsx src/scripts/tier-diag.ts",
    "reanalyze": "tsx src/scripts/reanalyze.ts",
    "l1:reburn": "tsx src/scripts/reburn-l1.ts",
    "flow:reburn": "tsx src/scripts/reburn-flows.ts"
  },
  "dependencies": {
    "@codebase-tutor/shared": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.3.2",
    "typescript": "^5.8.3",
    "typescript-language-server": "^4.3.4",
    "web-tree-sitter": "^0.27.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.3",
    "vitest": "^3.1.3"
  }
}
