    "qualityGates": [
      "题面三节完整",
      "测试断言不少于 2 条（TESTS 行 passed+failed）",
      "至少 1 条针对缺陷（given 那跑至少 1 条失败）"
    ]
  },
  "gate": {
    "purpose": "冒烟只作方向性止损，不作结论（n=3 对，按《实验设计》5.3 只报中位数与最大值）",
    "minRowsPerArm": 3,
    "maxSuccessDeficit": 1,
    "maxMedianDurationRatio": 1.1,
    "requireOversizedNotWorse": true,
    "systemErrorAborts": ["sandbox_unavailable", "request_error", "no_provider", "quota", "budget", "402"]
  },
  "criteria": {
    "medianDurationDropAtLeast": 0.1,
    "successRateDropAtMostPp": 5,
    "tokenIncreaseAtMost": 0.3,
