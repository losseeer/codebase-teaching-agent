# ============================================================
# Codebase Tutor — 引擎配置模板
# 用法：复制为 .env 后填写；启动前导出（`set -a; source .env; set +a`）
#       或 `pnpm --filter @codebase-tutor/engine exec tsx --env-file=../../.env src/server.ts`
# 不配置任何 LLM 时引擎完全可用（本地启发式摘要 + 规则教学）。
# ============================================================

# ---- LLM（只有一套配置；GUI 可整条覆盖：服务商 / 模型 / 接口地址 / API Key / 思考档位）----
# GUI 的设置落盘在 ~/.codebase-tutor/llm-settings.json（0600，重启仍在）；本节是**降级策略**：
# GUI 某项留空即用这里的值，从来没用过 GUI 也照样按 .env 跑。
# 2026-09-18 起不再区分「轻量 / 主力」两档：对话与轻任务共用这套配置，
# 「轻任务」是运行时角色（推荐入口/题面润色/命名/L1 摘要，思考强制关闭），不是第二份配置。
# provider：openai | openai-compatible | anthropic | ollama（留空 = 不启用 LLM，引擎全本地可用）
TUTOR_LLM_PROVIDER=
# 模型名（留空时 openai 默认 gpt-4o-mini / anthropic 默认 claude-3-5-sonnet / ollama 默认 llama3.2）
# ⚠️ 旧变量 TUTOR_TEACHING_* 仍被读取（兼容旧 .env，不至于静默失效），但 TUTOR_LLM_* 优先，不要再写。
TUTOR_LLM_MODEL=
# GUI 模型输入框的候选（逗号分隔的 slug）；不配也可以在 GUI 里直接填任意 slug
TUTOR_MODEL_PRESETS=

# ---- 文件摘要 L1（默认走上面的 LLM；这里是覆盖开关）----
# 留空 = 配置了 LLM 就用 LLM（轻任务角色、思考关闭、批量调用），没有则回落本地启发式摘要
# off / none / local = 强制本地启发式（不调模型）
# ollama = 改用本地 Ollama 逐文件摘要（见下方 TUTOR_OLLAMA_*）
TUTOR_SUMMARY_PROVIDER=

# 单次请求超时（毫秒）
TUTOR_LLM_TIMEOUT_MS=12000

# ---- OpenAI / 兼容端点 ----
OPENAI_API_KEY=
# 兼容端点可自定义（如 DeepSeek：https://api.deepseek.com/v1）
TUTOR_OPENAI_URL=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
TUTOR_ANTHROPIC_URL=

# ---- Ollama（本地模型，无需 key）----
TUTOR_OLLAMA_URL=
TUTOR_OLLAMA_MODEL=

# ---- LLM 工作日志（每次 provider 调用一条：场景 / 模型 / 耗时 / token / 缓存命中 / 工具 / 失败原因）----
# 留空 = 写 ~/.codebase-tutor/llm.log（JSONL，一行一条）；设 off = 只打控制台不落盘；也可给绝对路径
TUTOR_LLM_LOG=

# ---- 检索第四臂用的向量模型（与对话/摘要用的 DeepSeek 分开配，不复用 OPENAI_API_KEY）----
# 三项齐备才算配上（缺任何一项 = 没有 dense/hybrid 两臂，评测台架照常出词法三臂读数）。
# 目前只有两个消费者：`pnpm search:embed`（建向量，要 --yes 才花钱）与 `pnpm phaseB:eval -- --dense`（发查询嵌入）。
# 产品检索路径还没接向量——四臂读数没出来之前不接。DashScope 兼容模式 v3/v4 单请求上限 10 条，客户端已按 10 分批。
TUTOR_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TUTOR_EMBED_MODEL=text-embedding-v3
TUTOR_EMBED_API_KEY=你的 DashScope key
TUTOR_EMBED_DIMENSIONS=1024

# ---- 计费单价（每百万 token 的美元价；成本监控页的金额与「预算触顶自动降级」都按这三档算）----
# 三档分别计价：输入未命中、输入命中前缀缓存、输出。留空 = 0，金额恒为 $0.0000（用量读数照常，不受影响）。
# 只配输入价与输出价时，命中的输入**按输入价计（不打折）**——宁可高估也不要把花掉的钱说少，
# 想要准确账面就把命中价显式配上（DeepSeek 这类端点命中价通常是输入价的 1/10）。
TUTOR_INPUT_USD_PER_MILLION=
TUTOR_CACHE_HIT_USD_PER_MILLION=
TUTOR_OUTPUT_USD_PER_MILLION=



# ---- 多仓挂载上限（内存里的仓库数 = fs 监听数）----
# 引擎记一张地址簿（~/.codebase-tutor/repositories.json，你导入过的仓都在里面，最近使用排在最后），
# 启动时一条都不读产物、不开监听；GUI 访问哪个仓才把它挂进内存。同时只留最近用过的这几个真占资源，
# 超出的按 LRU 驱逐（关它的监听、从内存摘掉；产物仍在该仓自己的 .tutor/ 里，下次访问重新挂）。
# 留空 = 3。地址簿本身没有条数上限，这个数只限制「同时挂载」。
TUTOR_MAX_MOUNTED=

# ---- 认证闸（企业形态才需要；本机默认关）----
# 默认读 ~/.codebase-tutor/api-keys.json，格式：
#   { "keys": [{ "name": "CI", "key": "至少 16 字符的随机串", "repositories": ["*"] }] }
# **没有这个文件（或清单本来就是空的）= 完全没有闸**，任何本机请求都能读写地址簿里的仓；
# 但**文件在而读不出来**（JSON 坏、权限被改、写了 key 却全都短于 16 字符）按「拒绝全部」跑：除 /api/health 外一律 503，
# 因为「把这份文件编辑到一半」那几秒钟不该等于整机摊开。启动日志与 GET /api/health 的 auth 字段都报这三档（off / api-key / broken）。
# 改文件不需要重启（按 mtime 重读）；已建起来的事件流最迟一个心跳（25s）内发现自己这张 key 已被撤掉，会自己断开。
# 开闸后：除 /api/health 与 CORS 预检以外全部要带 x-api-key 或 Authorization: Bearer，否则 401；
# repositories 限定这张 key 能开哪些仓（仓 id 或 "*"）——名单外的仓 403、不在清单里、也进不了跨仓工具，
# 连 /api/events 推过来的导入进度都按这张名单过滤过（那帧里带着目标仓的绝对路径）。
# 只有不受限的 key（"*"）能碰全局的事：改模型配置（baseUrl 一改，别人下一轮的源码就出境到新端点）、发起导入。
# 「停止生成」按归属判：那一轮由哪张 key 发起就只有它停得了。
# GUI 带着口令能用：闸门开着时侧栏会出「引擎访问口令」一行，存进本浏览器后所有请求（含导入进度事件流）自动带上；
# 口令在 localStorage 里对同源脚本可读，这是便利性取舍不是安全存储——真边界是这份文件与按仓授权（见开发日志 §44/§47/§48）。
# 这里留空 = 用默认路径；给绝对路径可以指到别处。
TUTOR_API_KEYS_FILE=
