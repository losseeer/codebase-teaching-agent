# ============================================================
# Codebase Tutor — 引擎配置模板
# 用法：复制为 .env 后填写；启动前导出（`set -a; source .env; set +a`）
#       或 `pnpm --filter @codebase-tutor/engine exec tsx --env-file=../../.env src/server.ts`
# 不配置任何 LLM 时引擎完全可用（本地启发式摘要 + 规则教学）。
# ============================================================

# ---- 教学 LLM（两档配置）----
# 重量级（主力档，TUTOR_TEACHING_*）：①三作用域 codebase agent 对话（harness；预算触顶自动降级本地规则回复）
# 轻量级（TUTOR_LIGHT_*，可选）：②教学模块「推荐入口」③练习生成题面润色 ④课程地图生成（均为单轮调用；未配置回落主力档）
# provider：openai | openai-compatible | anthropic | ollama（留空 = 不启用 LLM）
TUTOR_TEACHING_PROVIDER=
# 模型名（留空时 openai 默认 gpt-4o-mini / anthropic 默认 claude-3-5-sonnet / ollama 默认 llama3.2）
TUTOR_TEACHING_MODEL=

# ---- 轻量级 LLM（可选）：三个单轮轻任务专用 ----
# 适用：教学模块推荐入口 / 练习题面润色 / 课程地图命名完善
# 不配置时自动回落上面的主力档；端点与密钥变量与主力档共用
# 例：TUTOR_LIGHT_PROVIDER=ollama TUTOR_LIGHT_MODEL=qwen2.5:3b（本地零成本）
#     TUTOR_LIGHT_PROVIDER=openai-compatible TUTOR_LIGHT_MODEL=deepseek-chat
TUTOR_LIGHT_PROVIDER=
TUTOR_LIGHT_MODEL=

# ---- 文件摘要（独立于教学 LLM；ollama 时每个文件走本地模型摘要）----
# 留空 = 本地启发式摘要（零依赖）
TUTOR_SUMMARY_PROVIDER=

# 单次请求超时（毫秒）
TUTOR_LLM_TIMEOUT_MS=12000

# ---- OpenAI / 兼容端点 ----
OPENAI_API_KEY=
# 兼容端点可自定义（如 DeepSeek：https://api.deepseek.com/v1）
TUTOR_OPENAI_URL=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
TUTOR_ANTHROPIC_URL=

# ---- Ollama（本地模型，无需 key）----
TUTOR_OLLAMA_URL=
TUTOR_OLLAMA_MODEL=


