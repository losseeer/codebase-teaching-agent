# ============================================================
# Codebase Tutor — 引擎配置模板
# 用法：复制为 .env 后填写；启动前导出（`set -a; source .env; set +a`）
#       或 `pnpm --filter @codebase-tutor/engine exec tsx --env-file=../../.env src/server.ts`
# 不配置任何 LLM 时引擎完全可用（本地启发式摘要 + 规则教学）。
# ============================================================

# ---- LLM（只有一套配置；GUI 可整条覆盖：服务商 / 模型 / 接口地址 / API Key / 思考档位）----
# GUI 的设置落盘在 ~/.codebase-tutor/llm-settings.json（0600，重启仍在）；本节是**降级策略**：
# GUI 某项留空即用这里的值，从来没用过 GUI 也照样按 .env 跑。
# 2026-09-18 起不再区分「轻量 / 主力」两档：对话与轻任务共用这套配置，
# 「轻任务」是运行时角色（推荐入口/题面润色/命名/L1 摘要，思考强制关闭），不是第二份配置。
# provider：openai | openai-compatible | anthropic | ollama（留空 = 不启用 LLM，引擎全本地可用）
TUTOR_LLM_PROVIDER=
# 模型名（留空时 openai 默认 gpt-4o-mini / anthropic 默认 claude-3-5-sonnet / ollama 默认 llama3.2）
# ⚠️ 旧变量 TUTOR_TEACHING_* 仍被读取（兼容旧 .env，不至于静默失效），但 TUTOR_LLM_* 优先，不要再写。
TUTOR_LLM_MODEL=
# GUI 模型输入框的候选（逗号分隔的 slug）；不配也可以在 GUI 里直接填任意 slug
TUTOR_MODEL_PRESETS=

# ---- 文件摘要 L1（默认走上面的 LLM；这里是覆盖开关）----
# 留空 = 配置了 LLM 就用 LLM（轻任务角色、思考关闭、批量调用），没有则回落本地启发式摘要
# off / none / local = 强制本地启发式（不调模型）
# ollama = 改用本地 Ollama 逐文件摘要（见下方 TUTOR_OLLAMA_*）
TUTOR_SUMMARY_PROVIDER=

# 单次请求超时（毫秒）
TUTOR_LLM_TIMEOUT_MS=12000

# ---- OpenAI / 兼容端点 ----
OPENAI_API_KEY=
# 兼容端点可自定义（如 DeepSeek：https://api.deepseek.com/v1）
TUTOR_OPENAI_URL=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
TUTOR_ANTHROPIC_URL=

# ---- Ollama（本地模型，无需 key）----
TUTOR_OLLAMA_URL=
TUTOR_OLLAMA_MODEL=

# ---- 推理预算的余量（「被 max_tokens 截断且正文为空」那一族的主因）----
# 推理模型（DeepSeek 系等）把思考 token 计入 max_tokens，调用点按非推理模型设的小上限会被思考烧光。
# 这一档直接加在每一发的 max_tokens 上（非推理模型不会为多余上限多花 token，用完即停，所以无条件加上是安全的）。
# 默认 6000（9-18 实测校准：map.flow 的自然思考量 2.4k~4.2k+）；填 0 = 关闭。
# 第一发被挤空时引擎自动抬一档（正文预算 + 2×余量）再发一次，并在 llm.log 里留 headroomEscalated；
# 两发都空才抛错。依据与口径见开发日志 §62、§65。
TUTOR_LLM_REASONING_HEADROOM=

# ---- LLM 工作日志（每次 provider 调用一条：场景 / 模型 / 耗时 / token / 缓存命中 / 工具 / 失败原因）----
# 留空 = 写 ~/.codebase-tutor/llm.log（JSONL，一行一条）；设 off = 只打控制台不落盘；也可给绝对路径
TUTOR_LLM_LOG=

# ---- 外部能力面（产品 agent 消费外部东西的两条通道，2026-10-17 建；格式跟业界规格，不自研）----
# 都是**默认关闭**：变量留空 = 引擎一个外部工具都不给，工具清单与上下文逐字不变（不是开关，是「不加」）。
# 装了什么、被跳过的为什么跳过：`curl http://127.0.0.1:3001/api/external`（零 token；读它会顺带把没连上的 server 拉起一次）。
# 技能目录：Agent Skills 规格——每个目录一份 SKILL.md，frontmatter 必填 name（≤64 字、小写字母/数字/单个连字符、必须等于目录名）
# 与 description（≤1024 字，原样进清单、不裁短）；可选 license / allowed-tools / metadata 解析但不消费（权限落在代码那侧）。
# 清单每轮都付费、正文与目录内附属文件按需取，所以最多露 12 份。
# 留空 = 认 ~/.codebase-tutor/skills 与 ~/.claude/skills 两处（后者直接复用社区已发布的技能包）；
# 要列多处用 `:` 或 `,` 分隔。**引擎不扫被学习仓里的 skills/**——仓自带的指令文件进上下文就是提示注入面。
TUTOR_SKILLS_DIR=
# 第三方 MCP server 的配置文件。形状与各家客户端一致，官方 README 里的片段可以直接贴进来：
#   { "mcpServers": { "docs": { "command": "npx", "args": ["-y", "@some/mcp-docs"], "env": { "TOKEN": "…" },
#                             "allowedTools": ["mcp__docs__search"], "disabled": false } } }
# 段的键名只许小写字母/数字/下划线/连字符——它要拼进工具名 mcp__<name>__<tool>，服务商按 ASCII 校验工具名。
# `allowedTools` 是白名单（写完整 id 或裸工具名都认）：不写就等于把该 server 报上来的全部工具交到模型手上，
# 因为那些程序是别人写的，副作用我们看不见。`env` 里常放第三方密钥：值从不回显、从不落日志。
# ⚠️ 远程 server（`url` + `type`）现在不接，会在读数里写明被跳过的原因（前置：外部调用的出境记账与 fail-closed，#175）。
# 留空 = ~/.codebase-tutor/mcp.json。
TUTOR_MCP_SETTINGS_FILE=
# 单次外部工具调用的墙钟上限（毫秒，下限夹到 1000；每次调用现读，改完不必重启引擎）。留空 = 20000。
TUTOR_MCP_TIMEOUT_MS=

# ---- 检索第四臂用的向量模型（与对话/摘要用的 DeepSeek 分开配，不复用 OPENAI_API_KEY）----
# 三项齐备才算配上（缺任何一项 = 没有 dense/hybrid 两臂，评测台架照常出词法三臂读数）。
# 目前只有两个消费者：`pnpm search:embed`（建向量，要 --yes 才花钱）与 `pnpm phaseB:eval -- --dense`（发查询嵌入）。
# 产品检索路径还没接向量——四臂读数没出来之前不接。DashScope 兼容模式 v3/v4 单请求上限 10 条，客户端已按 10 分批。
TUTOR_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TUTOR_EMBED_MODEL=text-embedding-v3
TUTOR_EMBED_API_KEY=你的 DashScope key
TUTOR_EMBED_DIMENSIONS=1024

# ---- 计费单价（每百万 token 的**人民币**价；成本监控页的金额与「预算触顶自动降级」都按这三档算）----
# ⚠️ 键名里的 USD 是历史遗留：算术不看币种（tokens × 单价 ÷ 一百万），填哪种币就算出哪种币，界面统一按 ¥ 显示。
#    改名会牵动已落盘的 llm-settings.json 与接口契约，所以留着 —— 别按名字把这些数当美元读。
# 首选在界面上填：对话栏那排「模型与推理」弹窗 → 单价三格（存 ~/.codebase-tutor/llm-settings.json，改完立即生效，不用重启引擎）。
# 这里的值是**回落层**：弹窗里留空的那一格才从这里取数，改了 .env 需要重启引擎才生效。
# 三档分别计价：输入未命中、输入命中前缀缓存、输出。两层都留空 = 0，金额恒为 $0.0000（用量读数照常，不受影响），
# 且「超预算改走本地规则」这道闸因此不管事——引擎拿到的花费永远是 0，月预算形同虚设。
# 只配输入价与输出价时，命中的输入**按输入价计（不打折）**——宁可高估也不要把花掉的钱说少，
# 想要准确账面就把命中价显式配上（DeepSeek 这类端点命中价通常是输入价的 1/10）。
# 参照值（按人民币填）：DeepSeek 峰时 输入 2 / 命中 0.2 / 输出 8（元 / 百万 token）。
TUTOR_INPUT_USD_PER_MILLION=
TUTOR_CACHE_HIT_USD_PER_MILLION=
TUTOR_OUTPUT_USD_PER_MILLION=



# ---- 多仓挂载上限（内存里的仓库数 = fs 监听数）----
# 引擎记一张地址簿（~/.codebase-tutor/repositories.json，你导入过的仓都在里面，最近使用排在最后），
# 启动时一条都不读产物、不开监听；GUI 访问哪个仓才把它挂进内存。同时只留最近用过的这几个真占资源，
# 超出的按 LRU 驱逐（关它的监听、从内存摘掉；产物仍在该仓自己的 .tutor/ 里，下次访问重新挂）。
# 留空 = 3。地址簿本身没有条数上限，这个数只限制「同时挂载」。
TUTOR_MAX_MOUNTED=

# ---- 认证闸：已整体撤除（2026-10-15，开发日志 §64）----
# 引擎不再有 API key / 按仓授权 / 调用方身份这一层，`TUTOR_API_KEYS_FILE` 这个变量也随之删掉：
# 「谁能用这台引擎」从此等于「谁能登这台机器」。管浏览器那一侧的只有下面的来源闸。
# 审计线里 `actor` 这一列保留但新行恒 null（历史行有值，两份 JSONL 的列形状不变）。

# ---- 可信来源（浏览器 drive-by 的那道闸；认证撤了之后它是唯一的 Web 闸）----
# 引擎只听 127.0.0.1，但**浏览器里任意网页照样能把请求打到这个地址**——发请求不需要跨域权限，只有读响应才需要。
# 所以来源单独有一道判据：默认只信「没有 Origin 头的调用方」（本机 curl、进程管理器、GUI 的同源请求）
# 与「回环来源」（http(s)://localhost|127.0.0.1|[::1]，任意端口，vite dev :3000 → 引擎 :3001 属这一类）。
# 其余来源一律当场 403（reason=origin_not_trusted），handler 一行都不执行——不是「只不给 CORS 头」。
# 跨来源部署（把界面挂在别的域名/主机上）把那个来源的**完整 origin** 写进这里，逗号或空格分隔：
#   TUTOR_ALLOWED_ORIGINS=https://tutor.corp.dev:8443,http://10.0.0.7:3000
# 精确匹配到端口，不是前缀匹配。留空 = 只有默认那两类。判据一处：packages/engine/src/security/origins.ts。
# ⚠️ 这一道只管「浏览器里哪个页面能碰」，**不管本机进程**——认证闸撤了之后那一段没有判据了（§64）。
