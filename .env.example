# ============================================================
# Codebase Tutor — 引擎配置模板
# 用法：复制为 .env 后填写；启动前导出（`set -a; source .env; set +a`）
#       或 `pnpm --filter @codebase-tutor/engine exec tsx --env-file=../../.env src/server.ts`
# 不配置任何 LLM 时引擎完全可用（本地启发式摘要 + 规则教学）。
# ============================================================

# ---- LLM（只有一套配置；GUI 可在运行时切换模型与思考档位，重启回落这里）----
# 2026-09-18 起不再区分「轻量 / 主力」两档：对话与轻任务共用这套配置，
# 「轻任务」是运行时角色（推荐入口/题面润色/命名/L1 摘要，思考强制关闭），不是第二份配置。
# provider：openai | openai-compatible | anthropic | ollama（留空 = 不启用 LLM，引擎全本地可用）
TUTOR_LLM_PROVIDER=
# 模型名（留空时 openai 默认 gpt-4o-mini / anthropic 默认 claude-3-5-sonnet / ollama 默认 llama3.2）
# ⚠️ 旧变量 TUTOR_TEACHING_* 仍被读取（兼容旧 .env，不至于静默失效），但 TUTOR_LLM_* 优先，不要再写。
TUTOR_LLM_MODEL=

# ---- 文件摘要 L1（默认走上面的 LLM；这里是覆盖开关）----
# 留空 = 配置了 LLM 就用 LLM（轻任务角色、思考关闭、批量调用），没有则回落本地启发式摘要
# off / none / local = 强制本地启发式（不调模型）
# ollama = 改用本地 Ollama 逐文件摘要（见下方 TUTOR_OLLAMA_*）
TUTOR_SUMMARY_PROVIDER=

# 单次请求超时（毫秒）
TUTOR_LLM_TIMEOUT_MS=12000

# ---- OpenAI / 兼容端点 ----
OPENAI_API_KEY=
# 兼容端点可自定义（如 DeepSeek：https://api.deepseek.com/v1）
TUTOR_OPENAI_URL=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
TUTOR_ANTHROPIC_URL=

# ---- Ollama（本地模型，无需 key）----
TUTOR_OLLAMA_URL=
TUTOR_OLLAMA_MODEL=

# ---- LLM 工作日志（每次 provider 调用一条：场景 / 模型 / 耗时 / token / 缓存命中 / 工具 / 失败原因）----
# 留空 = 写 ~/.codebase-tutor/llm.log（JSONL，一行一条）；设 off = 只打控制台不落盘；也可给绝对路径
TUTOR_LLM_LOG=


