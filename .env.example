# ============================================================
# Codebase Tutor — 引擎配置模板
# 复制成 .env 用；引擎启动自动读仓库根 .env，已存在的环境变量优先。
# **① 那六个填了就能跑**；② ③ 都有默认值，不知道要改就别动。一个都不配引擎也能启动（摘要回落本地启发式）。
# 模型、单价、思考档位优先在界面（成本页 / 模型弹窗）配，落盘 ~/.codebase-tutor/llm-settings.json，这里只是它的回落层。
# ============================================================

# ---- ① 要配的（不配模型 = 只有本地启发式与规则问答）----
TUTOR_LLM_PROVIDER=              # openai | openai-compatible | anthropic | ollama；留空 = 不启用模型
TUTOR_LLM_MODEL=                 # 留空按协议取默认
OPENAI_API_KEY=                  # 兼容端点也用这个名；用 anthropic 才填下面那行
ANTHROPIC_API_KEY=
TUTOR_OPENAI_URL=                # 兼容端点，如 https://api.deepseek.com/v1
TUTOR_OLLAMA_URL=                # 只有 provider=ollama 才用，留空 = http://127.0.0.1:11434

# ---- ② 有默认值，一般不用动 ----
TUTOR_LLM_TIMEOUT_MS=12000       # 单次请求超时
TUTOR_LLM_REASONING_HEADROOM=    # 推理预算余量，加在每发 max_tokens 上；留空 = 6000，填 0 = 关闭（§62、§65）
TUTOR_THINKING_STYLES=           # 能力表外的模型：前缀=deepseek|openai|anthropic|none，逗号分隔
TUTOR_SUMMARY_PROVIDER=          # 文件摘要 L1：留空 = 配了模型就用；off|local = 强制本地启发式；ollama = 本地逐文件摘要
TUTOR_OLLAMA_MODEL=              # 摘要走本地 Ollama 时的模型名
TUTOR_MAX_MOUNTED=               # 同时挂载的仓数，默认 3，超出按最近最少使用驱逐
ENGINE_PORT=                     # 默认 3001，只听 127.0.0.1
TUTOR_ALLOWED_ORIGINS=           # 跨来源部署才填：完整 origin，逗号或空格分隔，精确到端口（认证撤除后唯一的 Web 闸，§64）
TUTOR_LLM_LOG=                   # 每次模型调用一行（对账只认它）。留空 = ~/.codebase-tutor/llm.log；off = 只打控制台
TUTOR_ENGINE_LOG=                # 引擎自身 JSONL。留空 = ~/.codebase-tutor/engine.jsonl；off = 不落盘
TUTOR_INPUT_USD_PER_MILLION=     # 每百万 token 三档单价（输入未命中 / 命中前缀缓存 / 输出）。键名里的 USD 是历史遗留：
TUTOR_CACHE_HIT_USD_PER_MILLION= # 算术不看币种，填人民币就算人民币。三档全空 = 金额恒 0 且预算闸门不管事
TUTOR_OUTPUT_USD_PER_MILLION=

# ---- ③ 外部能力（默认关闭：留空 = 一个外部工具都不给，工具清单与上下文逐字不变）----
# 装了什么、被谁跳过：curl http://127.0.0.1:3001/api/external（零 token）
TUTOR_SKILLS_DIR=                # 留空 = ~/.codebase-tutor/skills 与 ~/.claude/skills；多处用 : 或 , 分隔。出厂预置技能开机复制到第一处，同名不覆盖
TUTOR_MCP_SETTINGS_FILE=         # 留空 = ~/.codebase-tutor/mcp.json。顶层 mcpServers，一段一个 server；allowedTools 是白名单，不写 = 该 server 全部工具交给模型
TUTOR_MCP_TIMEOUT_MS=            # 单次外部调用上限，留空 = 20000（每次调用现读，改完不必重启）

# ---- ④ 只有跑评测与测试才用（产品路径不读；写在代码里，这里不占键位）----
# TUTOR_REGISTRY_FILE（地址簿路径）、TUTOR_LLM_SETTINGS_FILE（GUI 设置落点）  测试把产品数据指到临时目录用
# TUTOR_BOOT_TIMING=1（启动分段回显）、TUTOR_TEST_FORCE_UNSUPPORTED=1（沙箱用例按「环境不支持」自我跳过）
