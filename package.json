{
  "name": "codebase-tutor",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.1",
  "workspaces": [
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "concurrently -n engine,gui -c cyan,magenta \"pnpm --filter @codebase-tutor/engine dev\" \"pnpm --filter @codebase-tutor/gui dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @codebase-tutor/engine test:watch",
    "lint": "pnpm -r lint",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "postinstall": "pnpm --filter @codebase-tutor/engine run setup:native",
    "setup:native": "pnpm --filter @codebase-tutor/engine run setup:native",
    "experiment": "pnpm --filter @codebase-tutor/engine experiment",
    "experiment:baseline": "pnpm --filter @codebase-tutor/engine experiment:baseline",
    "eval:metrics": "pnpm --filter @codebase-tutor/engine eval:metrics",
    "eval:quality": "pnpm --filter @codebase-tutor/engine eval:quality",
    "eval:judge": "pnpm --filter @codebase-tutor/engine eval:judge",
    "probe:code-exercise": "pnpm --filter @codebase-tutor/engine probe:code-exercise",
    "probe:cache": "pnpm --filter @codebase-tutor/engine probe:cache",
    "probe:sandbox": "pnpm --filter @codebase-tutor/engine probe:sandbox",
    "probe:graph": "pnpm --filter @codebase-tutor/engine probe:graph",
    "probe:calls": "pnpm --filter @codebase-tutor/engine probe:calls",
    "facts:report": "pnpm --filter @codebase-tutor/engine facts:report"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  }
}
