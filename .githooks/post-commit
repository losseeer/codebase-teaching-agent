#!/bin/sh
# 出厂技能有改动时，把副本同步到用户技能目录（config.json 不覆盖）。
# 安装：git config core.hooksPath .githooks
# 演练：SKILLS_SYNC_DRY=1 git commit ... 只打印将执行的命令。

changed=$(git show --pretty=format: --name-only HEAD | grep '^packages/engine/skills/' || true)
[ -z "$changed" ] && exit 0

root=$(git rev-parse --show-toplevel)
pnpm_bin=$(command -v pnpm || echo /opt/homebrew/bin/pnpm)
cd "$root/packages/engine" || exit 0

if [ -n "${SKILLS_SYNC_DRY:-}" ]; then
  echo "[skills-sync] 将执行：$pnpm_bin skills:sync --force（改动 $(printf '%s\n' "$changed" | wc -l | tr -d ' ') 个技能文件）"
  exit 0
fi

"$pnpm_bin" skills:sync --force || echo "[skills-sync] 同步失败：请手动运行 pnpm --filter @codebase-tutor/engine skills:sync --force"
